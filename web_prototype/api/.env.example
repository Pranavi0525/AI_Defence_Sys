# web_prototype/api/.env.example
#
# Copy to `.env` for local use with a tool like `python-dotenv`, or set
# these directly as environment variables on your deployment platform
# (e.g. Render's "Environment" tab). See settings.py's docstring for the
# authoritative description of each variable's behavior and defaults.
#
# Setting NONE of these reproduces today's local-dev behavior exactly
# (wide-open CORS, bind 127.0.0.1:8000, INFO logging).

# "development" | "staging" | "production". Default: "development".
# In staging/production, CORS_ALLOWED_ORIGINS becomes REQUIRED (see below).
ENVIRONMENT=production

# Comma-separated list of exact origins allowed to call this API from a
# browser. Required in staging/production. Use the real deployed Vercel
# URL(s) here -- e.g. after deploying the frontend, set:
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Only set this to "true" if you intentionally want ENVIRONMENT=production
# to accept requests from ANY origin (CORS_ALLOWED_ORIGINS=*). Leave unset
# for a normal deployment.
# CORS_ALLOW_ALL_ORIGINS_UNSAFE=false

# Render (and most PaaS providers) inject $PORT automatically -- you do
# NOT need to set this yourself on Render. Included here for local
# parity testing only.
# PORT=10000

# NOTE: settings.py also reads API_HOST / API_PORT, but run_api.py's own
# --host/--port CLI flags take precedence over both of these when passed
# explicitly on the command line (which is what the Render start command
# below does). Left unset here to avoid the false impression that setting
# these alone is sufficient -- the start command must also pass
# `--host 0.0.0.0 --port $PORT` explicitly. See render.yaml.
# API_HOST=0.0.0.0
# API_PORT=10000

# Optional human-readable label for the deployed model (e.g. a release
# tag). Falls back to the git-commit-based version computed from the
# saved model artifacts if unset.
# MODEL_VERSION=

# "DEBUG" | "INFO" | "WARNING" | "ERROR". Default: "INFO".
# LOG_LEVEL=INFO
